{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SITE_STATE", "class_name": "SiteState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SiteState"] }],
  "preview_urls": true,
  "previews": {}
}