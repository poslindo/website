{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "vars": {
    "RECAPTCHA_SITE_KEY": "6LfX9gouAAAAANB7WVugr1lqUKs0FEDceC0NEaLY", 
    "ACCESS_AUD": "7f96940ef95bb7c4f246b1dfc607ac1fbc6884122291c794974b28e81984f1de",
    "ACCESS_TEAM_DOMAIN": "https://usuiensan.cloudflareaccess.com",
    "CONTENT_REPOSITORY": "poslindo/website",
    "CONTENT_BRANCH": "main",
  },
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SITE_STATE", "class_name": "SiteState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SiteState"] }],
  "r2_buckets": [{ "binding": "BOARD_BACKUPS", "bucket_name": "poslin-board-backups" }],
  "triggers": { "crons": ["0 18 * * *"] },
  "preview_urls": true,
  "previews": {}
}
